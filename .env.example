# Токен из @BotFather
BOT_TOKEN=

# Числовые Telegram id через запятую. Узнать: команда /id в боте.
ADMIN_IDS=

# Канал можно не заполнять: админ пересылает боту любой пост и бот запоминает id.
CHANNEL_ID=

# Публичный https-адрес этой программы. Пока пусто — бот сам спрашивает статус платежа.
PUBLIC_BASE_URL=

# Тестовый терминал: Магазины → магазин → Терминалы → Тестовый → Настроить
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# 1 — сохранять карту (Recurrent=Y). 0 — не сохранять.
# Пусто: на ключе с суффиксом DEMO карта не сохраняется, иначе сохраняется.
# Тест кабинета «Успешная оплата» не засчитывается, если в платеже есть Recurrent=Y.
TBANK_RECURRENT=

# АУСН «доходы» = usn_income. АУСН «доходы минус расходы» = usn_income_outcome.
# В чеке отдельного признака АУСН нет: налоговая определяет режим по ИНН.
TAXATION=usn_income

# Пароль страницы /admin. Промокод, созданный там, сразу виден боту.
ADMIN_PASSWORD=

PORT=8741
DB_PATH=data/private.sqlite3
